#!/usr/bin/env bash
#
# Opt-in pre-commit hook. It runs two independent guards:
#
#   * privacy guard #2  (`expensuchis.privacy`)  — refuses data-bearing FILES
#     (statements, ledgers, exports) inside this public repository.
#   * privacy guard #3  (`expensuchis.leakguard`) — refuses repository CONTENT
#     that repeats a token from the private statements (see leakguard.py).
#
# Activate it once, from the repository root:
#
#     git config core.hooksPath .githooks
#
# It runs the package without requiring an activated virtualenv: it uses `uv`
# when available and falls back to `PYTHONPATH=src python3`. If neither can run
# the scans it fails closed. The hook is bypassable with `git commit --no-verify`;
# CI is not.
#
# Leak-guard exit codes: 0 for a clean run or an absent ledger directory (a fresh
# clone or CI has no statements, and the repository must stay usable without
# them), 1 for a leaked token, 2 for a configured-but-unusable ledger. Only 0
# allows the commit.
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

if command -v uv >/dev/null 2>&1; then
    run_scan() { uv run python -m "$1"; }
elif command -v python3 >/dev/null 2>&1; then
    run_scan() { PYTHONPATH=src python3 -m "$1"; }
else
    echo "pre-commit: neither 'uv' nor 'python3' is available; refusing commit." >&2
    exit 1
fi

run_scan expensuchis.privacy
privacy_status=$?
run_scan expensuchis.leakguard
leak_status=$?

if [ "$privacy_status" -eq 0 ] && [ "$leak_status" -eq 0 ]; then
    exit 0
fi

if [ "$privacy_status" -eq 1 ]; then
    echo "privacy pre-commit: data-bearing files found above; refusing commit." >&2
    echo "Move them outside this public repository, or bypass with 'git commit --no-verify'." >&2
elif [ "$privacy_status" -ne 0 ]; then
    echo "privacy pre-commit: the privacy scan could not run (exit $privacy_status); refusing commit." >&2
fi

if [ "$leak_status" -eq 1 ]; then
    echo "leakguard pre-commit: statement tokens leaked into the repository; refusing commit." >&2
    echo "Remove them, or review and add a generic token to the baseline deliberately." >&2
elif [ "$leak_status" -ne 0 ]; then
    echo "leakguard pre-commit: the leak guard could not verify the repository (exit $leak_status); refusing commit." >&2
fi

exit 1
